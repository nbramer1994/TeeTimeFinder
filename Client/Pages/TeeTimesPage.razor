@page "/"
@page "/teetimes"
@inject HttpClient Http

<PageTitle>Tee Time Finder</PageTitle>

<section class="panel">
    <div class="filters">
        <div class="field">
            <label for="date">Date</label>
            <input id="date" type="date" class="form-control" @bind="date" />
        </div>
        <div class="field">
            <label for="from">From</label>
            <input id="from" type="time" class="form-control" @bind="fromTime" />
        </div>
        <div class="field">
            <label for="to">To</label>
            <input id="to" type="time" class="form-control" @bind="toTime" />
        </div>
        <div class="field field-action">
            <button class="btn btn-primary search-btn" @onclick="SearchAsync" disabled="@loading">
                @(loading ? "Searching..." : "Search")
            </button>
        </div>
    </div>

    @if (courses.Count > 0)
    {
        <div class="courses-header">
            <span class="courses-title">Courses (@selected.Count of @courses.Count)</span>
            <div class="courses-actions">
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="SelectAll">Select all</button>
                <button type="button" class="btn btn-sm btn-outline-secondary" @onclick="ClearAll">Remove all</button>
            </div>
        </div>
        <div class="chips">
            @foreach (var c in courses)
            {
                var isOn = selected.Contains(c.Id);
                <button type="button" class="chip @(isOn ? "chip-on" : "")" @onclick="() => Toggle(c.Id)">
                    @(isOn ? "✓ " : "")@c.Name
                </button>
            }
        </div>
    }
</section>

@if (errorMessage is not null)
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (loading)
{
    <p class="status"><em>Searching...</em></p>
}
else if (result is not null)
{
    @foreach (var err in result.Errors)
    {
        <div class="alert alert-warning">@err.CourseName: @err.Message</div>
    }

    var times = FilteredTimes();
    @if (times.Count == 0)
    {
        <p class="status">No tee times found for that date and time range.</p>
    }
    else
    {
        <p class="status">@times.Count tee times</p>
        <div class="results">
            <table class="table results-table">
                <thead>
                    <tr><th>Time</th><th>Course</th><th>Players</th><th>Holes</th><th>Price</th><th></th></tr>
                </thead>
                <tbody>
                    @foreach (var t in times)
                    {
                        <tr>
                            <td class="time">@t.Time.StartTime.ToString("h:mm tt")</td>
                            <td class="course">@t.Time.CourseName @if (Flyovers.TryGetValue(t.Time.CourseId, out var flyUrl)) { <a class="flyover-link" href="@flyUrl" target="_blank" rel="noopener">&#9654; Flyover</a> }</td>
                            <td data-label="Players">@(t.Time.AvailableSpots > 0 ? t.Time.AvailableSpots.ToString() : "-")</td>
                            <td data-label="Holes">@t.Holes</td>
                            <td data-label="Price">@(t.Time.Price?.ToString("C") ?? "-")</td>
                            <td class="text-end book-cell"><a class="book-link" href="@t.Time.BookingUrl" target="_blank" rel="noopener">Book</a></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    private DateTime date = DateTime.Today;
    private TimeOnly? fromTime = new(6, 0);
    private TimeOnly? toTime = new(20, 0);
    private bool loading;
    private List<CourseInfo> courses = [];
    private HashSet<string> selected = [];
    private TeeTimeSearchResult? result;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            courses = await Http.GetFromJsonAsync<List<CourseInfo>>("api/teetimes/courses") ?? [];
            selected = courses.Select(c => c.Id).ToHashSet();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load courses: {ex.Message}";
        }
    }

    private void Toggle(string id)
    {
        if (!selected.Remove(id)) selected.Add(id);
    }

    private void SelectAll() => selected = courses.Select(c => c.Id).ToHashSet();

    private void ClearAll() => selected = [];

    private sealed record TimeRow(TeeTime Time, string Holes);

    private static readonly Dictionary<string, string> Flyovers = new(StringComparer.OrdinalIgnoreCase)
    {
        ["diamond-springs"] = "https://www.youtube.com/watch?v=tPtyx5ZHzXc&list=PLVJVLrzAh7Rmu4CE5NrxgeFybqb7hG3bm",
        ["kaufman"] = "https://www.youtube.com/watch?v=Q2IB4-4hujs",
        ["scott-lake"] = "https://www.youtube.com/watch?v=lTfiENohJeE",
        ["mines"] = "https://www.youtube.com/watch?v=SlidBFDN7Vo",
        ["pigeon-creek"] = "https://www.youtube.com/watch?v=6kXsbaB2ox8",
        ["pines"] = "https://www.youtube.com/watch?v=T7IFEiLPxl8",
        ["quail-ridge"] = "https://www.youtube.com/watch?v=RSWRww7WY4A",
        ["the-meadows"] = "https://www.youtube.com/watch?v=yyrjcfYbxxY",
        ["ravines"] = "https://www.youtube.com/watch?v=E8JDFTMYwGM",
        ["thornapple-pointe"] = "https://www.youtube.com/watch?v=TpbZoMq8PTU"
    };

    private List<TimeRow> FilteredTimes()
    {
        var from = fromTime ?? TimeOnly.MinValue;
        var to = toTime ?? TimeOnly.MaxValue;
        return result!.TeeTimes
            .Where(x => TimeOnly.FromDateTime(x.StartTime) >= from && TimeOnly.FromDateTime(x.StartTime) <= to)
            .GroupBy(x => (x.CourseName, x.StartTime))
            .Select(g =>
            {
                var holes = g.Select(x => x.Holes).Where(h => h > 0).Distinct().Order().ToList();
                var first = g.OrderBy(x => x.Price ?? decimal.MaxValue).First();
                return new TimeRow(first, holes.Count == 0 ? "-" : string.Join("/", holes));
            })
            .OrderBy(r => r.Time.StartTime)
            .ToList();
    }

    private async Task SearchAsync()
    {
        if (selected.Count == 0)
        {
            errorMessage = "Select at least one course.";
            return;
        }

        loading = true;
        errorMessage = null;
        try
        {
            var query = $"api/teetimes?date={date:yyyy-MM-dd}" +
                        string.Concat(selected.Select(s => $"&courses={Uri.EscapeDataString(s)}"));
            result = await Http.GetFromJsonAsync<TeeTimeSearchResult>(query);
        }
        catch (Exception ex)
        {
            errorMessage = $"Search failed: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }
}
