@inherits LayoutComponentBase

<div class="app-shell">
    <header class="app-header">
        <div class="app-header-inner">
            <svg class="app-logo" viewBox="0 0 64 64" width="34" height="34" aria-hidden="true">
                <ellipse cx="32" cy="54" rx="22" ry="5" fill="rgba(255,255,255,.25)" />
                <rect x="31" y="8" width="3" height="46" rx="1.5" fill="#fff" />
                <path d="M34 8 L54 16 L34 24 Z" fill="#dfe7f3" />
                <circle cx="20" cy="50" r="4.5" fill="#fff" />
            </svg>
            <span class="app-title">Tee Time Finder</span>
        </div>
    </header>

    <main class="app-main">
        @Body
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
