using TeeTimeFinder.Core.Interfaces;
using TeeTimeFinder.Models;

namespace TeeTimeFinder.Api.Services;

public class TeeTimeSearchService(IEnumerable<ITeeTimeProvider> providers) : ITeeTimeSearchService
{
    private static readonly IReadOnlyList<CourseInfo> Courses =
    [
        new()
        {
            Id = "mines", Name = "The Mines", System = BookingSystem.Chronogolf,
            ExternalId = "18604", ScheduleId = "22220",
            BookingUrl = "https://www.chronogolf.com/club/18604"
        },
        new()
        {
            Id = "diamond-springs", Name = "Diamond Springs", System = BookingSystem.ForeUp,
            ExternalId = "21668", ScheduleId = "8514", BookingClassId = "10884",
            BookingUrl = "https://foreupsoftware.com/index.php/booking/21668/8514#teetimes"
        }
        // TODO: Pines (CPS Golf: thepines.cps.golf), Quail Ridge (ClubCaddie), Scott Lake, Kaufman,
        // Pigeon Creek and Thornapple Pointe need their booking ids / providers added.
    ];

    public IReadOnlyList<CourseInfo> GetCourses() => Courses;

    public async Task<TeeTimeSearchResult> SearchAsync(DateOnly date, int players, IEnumerable<string>? courseIds, CancellationToken cancellationToken = default)
    {
        var selected = courseIds?.ToHashSet(StringComparer.OrdinalIgnoreCase);
        var targets = Courses.Where(c => selected is null || selected.Count == 0 || selected.Contains(c.Id)).ToList();

        var tasks = targets.Select(async course =>
        {
            var provider = providers.FirstOrDefault(p => p.System == course.System);
            if (provider is null)
            {
                return (course, times: (IReadOnlyList<TeeTime>)[], error: "No provider for " + course.System);
            }

            try
            {
                return (course, times: await provider.GetTeeTimesAsync(course, date, players, cancellationToken), error: (string?)null);
            }
            catch (Exception ex) when (ex is not OperationCanceledException)
            {
                return (course, times: (IReadOnlyList<TeeTime>)[], error: ex.Message);
            }
        });

        var outcomes = await Task.WhenAll(tasks);
        var result = new TeeTimeSearchResult();
        foreach (var o in outcomes)
        {
            result.TeeTimes.AddRange(o.times.Where(t => t.AvailableSpots >= players));
            if (o.error is not null)
            {
                result.Errors.Add(new CourseSearchError { CourseName = o.course.Name, Message = o.error });
            }
        }

        result.TeeTimes = result.TeeTimes.OrderBy(t => t.StartTime).ToList();
        return result;
    }
}
