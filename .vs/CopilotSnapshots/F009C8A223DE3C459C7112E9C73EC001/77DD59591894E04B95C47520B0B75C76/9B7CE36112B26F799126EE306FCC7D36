using TeeTimeFinder.Api.Services;
using TeeTimeFinder.Core.Interfaces;

var builder = WebApplication.CreateBuilder(args);

// TODO: Add authentication here (e.g. AddMicrosoftIdentityWebAppAuthentication) if your app needs it.

builder.Services.AddHttpContextAccessor();
builder.Services.AddHealthChecks();

builder.Services.AddRazorComponents()
    .AddInteractiveWebAssemblyComponents();

// Example service registration. Define the interface in Core/Interfaces, implement it in
// Api/Services, then register it here so controllers can have it injected.
builder.Services.AddSingleton<ISampleService, SampleService>();

builder.Services.AddControllers();
builder.Services.AddEndpointsApiExplorer();

var app = builder.Build();

// TODO: If hosting under a sub path, call app.UsePathBase("/yourpath") here and update <base href> in App.razor.

if (app.Environment.IsDevelopment())
{
    app.UseWebAssemblyDebugging();
}
else
{
    app.UseExceptionHandler("/Error");
    app.UseHsts();
}

app.UseHttpsRedirection();

app.MapStaticAssets();

app.UseRouting();

app.UseAuthentication();
app.UseAuthorization();
app.UseAntiforgery();

app.MapHealthChecks("/health/ready");

app.MapRazorComponents<TeeTimeFinder.Api.Components.App>()
    .AddInteractiveWebAssemblyRenderMode()
    .AddAdditionalAssemblies(typeof(TeeTimeFinder.Client._Imports).Assembly);

app.MapControllers();

app.Run();
