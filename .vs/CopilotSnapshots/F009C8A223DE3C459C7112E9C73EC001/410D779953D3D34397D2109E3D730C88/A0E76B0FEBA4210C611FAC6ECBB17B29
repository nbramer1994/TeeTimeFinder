.app-shell {
    min-height: 100vh;
    background: #eef1f6;
}

.app-header {
    background: linear-gradient(135deg, #778FB5 0%, #4f6791 100%);
    color: #fff;
    box-shadow: 0 2px 8px rgba(40, 55, 85, 0.25);
}

.app-header-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 1rem 1.25rem;
    display: flex;
    align-items: center;
    gap: .65rem;
}

.app-logo {
    font-size: 1.6rem;
}

.app-title {
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: .02em;
}

.app-main {
    max-width: 1100px;
    margin: 0 auto;
    padding: 1.5rem 1.25rem 3rem;
}
